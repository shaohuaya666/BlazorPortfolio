@page "/"
@using System.Threading
@using BlazorPortfolio.Components
@using BlazorPortfolio.Models
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject IPortfolioService PortfolioService
@implements IAsyncDisposable

<PageTitle>个人简历（Blazor Server）</PageTitle>

<style>
    html {
        scroll-behavior: smooth;
    }

    section[id] {
        scroll-margin-top: 100px;
    }
</style>

@* 通过 CascadingValue 将 SignalR HubConnection 传递给所有子组件 *@
<CascadingValue Value="hubConnection">
    <PortfolioNav />

    <HeroSection ConnectionState="@(hubConnection?.State ?? HubConnectionState.Disconnected)" />

    <main class="max-w-7xl mx-auto px-6 pb-20 space-y-24">
        <AdvantagesSection Items="advantages" />

        <SkillsSection Categories="skillCategories" Diagnostics="skillDiagnostics" />

        <ExperienceSection Items="workHistories" />

        <ProjectsSection Items="compactProjects" />

        <ContactSection TraceLogs="traceLogs" ShowSuccessMsg="showSuccessMsg" />
    </main>

    <ResumeModal IsOpen="resumeModalOpen" OnClose="ToggleResumeModal" />
</CascadingValue>

@code {
    /// <summary>
    /// SignalR 连接实例（通过 CascadingValue 共享给子组件）
    /// </summary>
    private HubConnection? hubConnection;

    /// <summary>
    /// SignalR 日志追踪列表
    /// </summary>
    private List<string> traceLogs = new();

    /// <summary>
    /// 是否显示提交成功消息
    /// </summary>
    private bool showSuccessMsg = false;

    /// <summary>
    /// 简历模态框是否打开
    /// </summary>
    private bool resumeModalOpen = false;

    /// <summary>
    /// 从数据库加载的个人优势列表
    /// </summary>
    private List<Advantage> advantages = new();

    /// <summary>
    /// 从数据库加载的技术栈分类列表
    /// </summary>
    private List<SkillCategory> skillCategories = new();

    /// <summary>
    /// 从数据库加载的工作经历列表
    /// </summary>
    private List<WorkHistory> workHistories = new();

    /// <summary>
    /// 从数据库加载的项目经历列表
    /// </summary>
    private List<CompactProject> compactProjects = new();

    /// <summary>
    /// 从数据库加载的技能诊断字典（Key: 标签名）
    /// </summary>
    private Dictionary<string, SkillDiagnostic> skillDiagnostics = new();

    /// <summary>
    /// 页面初始化：从数据库加载数据、建立 SignalR 连接
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // 从数据库异步加载所有数据
        try
        {
            advantages = await PortfolioService.GetAdvantagesAsync();
            skillCategories = await PortfolioService.GetSkillCategoriesAsync();
            workHistories = await PortfolioService.GetWorkHistoriesAsync();
            compactProjects = await PortfolioService.GetCompactProjectsAsync();
            skillDiagnostics = await PortfolioService.GetSkillDiagnosticsAsync();
            AddLog("数据库数据加载完成。");
        }
        catch (Exception ex)
        {
            AddLog($"数据库加载失败: {ex.Message}");
        }

        // 初始化 SignalR 连接
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/portfolioHub"))
            .WithAutomaticReconnect()
            .Build();

        // 注册 SignalR 事件处理器
        hubConnection.On<string>("ReceiveContactLog", (log) =>
        {
            traceLogs.Add(log);
            if (traceLogs.Count > 10) traceLogs.RemoveAt(0);
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On<string>("ReceiveSystemLog", (log) =>
        {
            traceLogs.Add(log);
            if (traceLogs.Count > 10) traceLogs.RemoveAt(0);
            InvokeAsync(StateHasChanged);
        });

        hubConnection.On<string>("ContactSubmitSuccess", (message) =>
        {
            showSuccessMsg = true;
            traceLogs.Add($"[{DateTime.Now:HH:mm:ss}] SUCCESS: {message}");
            if (traceLogs.Count > 10) traceLogs.RemoveAt(0);
            InvokeAsync(StateHasChanged);

            // 3秒后隐藏成功消息
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                showSuccessMsg = false;
                InvokeAsync(StateHasChanged);
            });
        });

        // 启动 SignalR 连接
        try
        {
            await hubConnection.StartAsync();
            AddLog("SignalR 连接已建立 - 实时通信已激活");
        }
        catch (Exception ex)
        {
            AddLog($"SignalR 连接失败: {ex.Message}");
        }

        AddLog("个人简历系统初始化完成。");
    }

    /// <summary>
    /// 切换简历模态框显示状态
    /// </summary>
    private void ToggleResumeModal()
    {
        resumeModalOpen = !resumeModalOpen;
    }

    /// <summary>
    /// 向日志追踪列表追加一条带时间戳的消息（最多保留10条）
    /// </summary>
    private void AddLog(string msg)
    {
        traceLogs.Add($"[{DateTime.Now:HH:mm:ss}] {msg}");
        if (traceLogs.Count > 10) traceLogs.RemoveAt(0);
    }

    /// <summary>
    /// 组件销毁时释放 SignalR 连接
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
