{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AdminPortal": {
    "Url": "http://116.61.62.222:5001"
  },
  "ConnectionStrings": {
    "DefaultConnection": "在此处配置连接字符串，或通过环境特定配置文件覆盖"
  },
  "Cache": {
    "Provider": "Redis",
    "KeyPrefix": "BlazorPortfolio",
    "KeyVersion": "v1",
    "DefaultDurationMinutes": 30,
    "FallbackDurationMinutes": 5,
    "ExpirationJitterRatio": 0.1,
    "MaxJitterMinutes": 10,
    "NullValueDurationMinutes": 5,
    "MaxValueSizeKb": 512,
    "EnableDistributedLock": true,
    "SingleFlightWaitMs": 3000,
    "LockExpiryMs": 5000,
    "LockAcquireWaitMs": 1000,
    "LockRetryDelayMs": 200,
    "LockRetryCount": 5,
    "FailureThreshold": 3,
    "BreakDurationMs": 30000,
    "Redis": {
      "ConnectionString": "127.0.0.1:6379",
      "Database": 0,
      "ConnectTimeoutMs": 3000,
      "SyncTimeoutMs": 3000,
      "ConnectRetry": 2,
      "AbortOnConnectFail": false,
      "Ssl": false,
      "ClientName": "BlazorPortfolio"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  }
}
