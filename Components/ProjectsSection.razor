@using BlazorPortfolio.Models

<style>
    /* 悬停浮层内部滚动条：细窄、半透明、贴合暗色主题 */
    .project-desc-scroll {
        padding-right: 0.5rem; /* 文字与滚动条留出间距 */
        scrollbar-width: thin; /* Firefox */
        scrollbar-color: rgba(79, 219, 200, 0.35) transparent; /* Firefox */
    }

    .project-desc-scroll::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .project-desc-scroll::-webkit-scrollbar-track {
        background: transparent;
        margin: 6px 0;
    }

    .project-desc-scroll::-webkit-scrollbar-thumb {
        background: rgba(79, 219, 200, 0.35);
        border-radius: 9999px;
    }

    .project-desc-scroll::-webkit-scrollbar-thumb:hover {
        background: rgba(79, 219, 200, 0.7);
    }
</style>

<section id="projects">
    <div class="flex items-center gap-4 mb-10">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[#4fdbc8] text-xl">database</span>
            <h2 class="text-3xl font-bold text-white tracking-tight">项目经历</h2>
        </div>
        <div class="h-[1px] flex-grow bg-gradient-to-r from-slate-800 to-transparent"></div>
    </div>

    <div class="space-y-12">
        @* 重点项目：数据来自 FeaturedProjects 表（含标签页与量化指标） *@
        @if (OrderedProjects.Count == 0)
        {
            <!-- 空状态：数据库无重点项目数据 -->
            <div class="glass-card p-12 rounded-xl border border-dashed border-slate-700 text-center">
                <span class="material-symbols-outlined text-slate-600 text-5xl">folder_off</span>
                <p class="text-slate-400 text-sm mt-4 font-mono">[ EMPTY ] 暂无重点项目数据</p>
                <p class="text-slate-600 text-xs mt-2 leading-relaxed">
                    数据库 FeaturedProjects 表当前为空。
                    <br />请执行 deploy/sql 目录下的初始化脚本载入示例数据，或等待缓存过期后刷新页面。
                </p>
            </div>
        }
        else
        {
            @for (var i = 0; i < OrderedProjects.Count; i++)
            {
                <FeaturedProjectCard Project="OrderedProjects[i]" IsFirst="i == 0" />
            }
        }

        <!-- Compact Projects Grid -->
        <div class="mt-16">
            <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                <span class="material-symbols-outlined text-[#4fdbc8] text-lg">apps</span>
                其他项目经历
            </h3>
            @if (Items.Count == 0)
            {
                <!-- 空状态：数据库无其他项目数据 -->
                <div class="glass-card p-10 rounded-xl border border-dashed border-slate-700 text-center">
                    <span class="material-symbols-outlined text-slate-600 text-4xl">inbox</span>
                    <p class="text-slate-400 text-sm mt-3 font-mono">[ EMPTY ] 暂无其他项目数据</p>
                    <p class="text-slate-600 text-xs mt-2">
                        数据库 CompactProjects 表当前为空，请初始化数据后刷新页面。
                    </p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    @foreach (var project in Items)
                    {
                        <div class="glass-card p-6 rounded-xl border-l-4 border-l-[#4fdbc8] group cursor-pointer relative hover:z-30 flex flex-col h-full" style="min-height: 264px;">
                            <div class="flex items-start justify-between mb-3">
                                <div class="flex-grow">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="px-2 py-0.5 bg-[#3b82f6]/10 border border-[#3b82f6]/30 text-[#3b82f6] text-[10px] font-mono rounded">
                                            @project.Type
                                        </span>
                                        <span class="text-[10px] font-mono text-slate-500">@project.Year</span>
                                    </div>
                                    <h4 class="text-lg font-bold text-white group-hover:text-[#4fdbc8] transition-colors">
                                        @project.Title
                                    </h4>
                                </div>
                            </div>

                            <!-- 固定占据 4 行高度（4 × 1.625 × 0.875rem ≈ 5.75rem），保证所有卡片描述区高度一致 -->
                            <p class="text-sm text-slate-300 leading-relaxed mb-4 line-clamp-4" style="min-height: 5.75rem;">
                                @project.Desc
                            </p>

                            <div class="flex flex-wrap gap-2 pt-3 border-t border-slate-800/50 mt-auto">
                                @foreach (var skill in project.Skills)
                                {
                                    <span class="px-2 py-1 bg-slate-900/60 border border-slate-800 text-[#adc6ff] text-[10px] font-mono rounded">
                                        @skill.Name
                                    </span>
                                }
                            </div>

                            <!-- 悬停浮层：显示完整项目描述（内部滚动条已美化） -->
                            <div class="absolute inset-0 z-30 hidden group-hover:flex flex-col p-6 rounded-xl bg-[#010f1f]/95 backdrop-blur-md border border-[#3b82f6]/40 shadow-2xl">
                                <div class="flex items-center gap-2 mb-3 flex-shrink-0">
                                    <span class="material-symbols-outlined text-[#4fdbc8] text-base">description</span>
                                    <span class="text-xs font-mono text-[#4fdbc8] truncate">@project.Title</span>
                                </div>
                                <div class="project-desc-scroll flex-1 min-h-0 overflow-y-auto">
                                    <p class="text-sm text-slate-300 leading-relaxed whitespace-pre-wrap">@project.Desc</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public List<CompactProject> Items { get; set; } = new();

    /// <summary>
    /// 从数据库加载的重点项目列表（含标签页与量化指标）
    /// </summary>
    [Parameter, EditorRequired]
    public List<FeaturedProject> FeaturedProjects { get; set; } = new();

    /// <summary>按 SortOrder 升序排列后的重点项目</summary>
    private List<FeaturedProject> OrderedProjects => FeaturedProjects.OrderBy(p => p.SortOrder).ToList();
}
