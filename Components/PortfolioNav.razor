@inject IConfiguration Configuration

<nav class="bg-[#051424]/80 backdrop-blur-xl border-b border-slate-800/40 sticky top-0 z-50 transition-all duration-300">
    <div class="flex justify-between items-center w-full px-6 max-w-7xl mx-auto h-20">
        <!-- Logo -->
        <div class="font-mono text-lg font-bold tracking-tighter text-[#bec6e0] cursor-pointer hover:text-white transition-colors flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-[#4fdbc8] rounded-full animate-pulse"></span>
           (Blazor Server)
        </div>

        <!-- Links -->
        <div class="hidden md:flex items-center gap-8">
            <a href="#experience" class="font-mono text-xs uppercase tracking-widest text-[#c6c6cd] hover:text-[#bec6e0] transition-colors">
                工作经历
            </a>
            <a href="#projects" class="font-mono text-xs uppercase tracking-widest text-[#c6c6cd] hover:text-[#bec6e0] transition-colors">
                项目经历
            </a>
            <a href="#skills" class="font-mono text-xs uppercase tracking-widest text-[#c6c6cd] hover:text-[#bec6e0] transition-colors">
                技术栈
            </a>
            <a href="#contact" class="font-mono text-xs uppercase tracking-widest text-[#c6c6cd] hover:text-[#bec6e0] transition-colors">
                联系方式
            </a>

            @* 后台管理入口 *@
            @if (!string.IsNullOrWhiteSpace(_adminUrl))
            {
                <a href="@_adminUrl" target="_blank" rel="noopener noreferrer"
                   title="后台管理入口"
                   class="font-mono text-xs uppercase tracking-widest text-[#4fdbc8]/80 hover:text-[#4fdbc8] transition-colors flex items-center gap-1.5 whitespace-nowrap shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                    后台管理
                </a>
            }
        </div>

        <!-- Download CTA (placeholder) -->
        <div></div>
    </div>
</nav>

@code {
    /// <summary>后台管理地址（来自配置 AdminPortal:Url）</summary>
    private string? _adminUrl;

    protected override void OnInitialized()
    {
        _adminUrl = Configuration["AdminPortal:Url"];
    }
}
