@inject IConfiguration Configuration
@inject IJSRuntime JS

<nav class="bg-[#051424]/80 backdrop-blur-xl border-b border-slate-800/40 sticky top-0 z-50 transition-all duration-300">
    <div class="relative flex justify-between items-center w-full px-6 max-w-7xl mx-auto h-20">
        <!-- Logo -->
        <div class="font-mono text-lg font-bold tracking-tighter text-[#bec6e0] cursor-pointer hover:text-white transition-colors flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-[#4fdbc8] rounded-full animate-pulse"></span>
           (Blazor Server)
        </div>

        <!-- Links（绝对定位实现水平居中，不受两侧元素宽度影响） -->
        <div class="hidden md:flex items-center gap-8 absolute left-1/2 -translate-x-1/2">
            <a href="#experience" class="font-mono text-xs uppercase tracking-widest text-[#c6c6cd] hover:text-[#bec6e0] transition-colors">
                工作经历
            </a>
            <a href="#projects" class="font-mono text-xs uppercase tracking-widest text-[#c6c6cd] hover:text-[#bec6e0] transition-colors">
                项目经历
            </a>
            <a href="#skills" class="font-mono text-xs uppercase tracking-widest text-[#c6c6cd] hover:text-[#bec6e0] transition-colors">
                技术栈
            </a>
            <a href="#contact" class="font-mono text-xs uppercase tracking-widest text-[#c6c6cd] hover:text-[#bec6e0] transition-colors">
                联系方式
            </a>

            @* 后台管理入口：通过 JS window.open 打开，规避部分内嵌环境 target=_blank 落到 about:blank 的问题 *@
            @if (!string.IsNullOrWhiteSpace(_adminUrl))
            {
                <a href="@_adminUrl" target="_blank" rel="noopener noreferrer"
                   title="后台管理入口"
                   @onclick="OpenAdminAsync" @onclick:preventDefault
                   class="font-mono text-xs uppercase tracking-widest text-[#c6c6cd] hover:text-[#bec6e0] transition-colors whitespace-nowrap">
                    后台管理
                </a>
            }
        </div>

        <!-- GitHub 仓库地址入口 -->
        <a href="@_repoUrl" target="_blank" rel="noopener noreferrer"
           title="@_repoUrl"
           class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg border border-slate-700/60 text-xs font-mono uppercase tracking-widest text-[#c6c6cd] hover:text-[#bec6e0] hover:border-[#4fdbc8]/40 hover:bg-white/5 transition-colors no-underline">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd"
                      d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.31.678.921.678 1.856 0 1.34-.012 2.42-.012 2.75 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span class="hidden sm:inline">GitHub</span>
        </a>
    </div>
</nav>

@code {
    /// <summary>本项目 Git 仓库地址</summary>
    private const string _repoUrl = "https://github.com/shaohuaya666/BlazorPortfolio";

    /// <summary>后台管理地址（来自配置 AdminPortal:Url）</summary>
    private string? _adminUrl;

    protected override void OnInitialized()
    {
        _adminUrl = Configuration["AdminPortal:Url"];
    }

    /// <summary>
    /// 显式通过 window.open 新开标签页。
    /// 部分内嵌 webview/iframe 环境对 target="_blank" 的默认处理不完整（新标签页停在 about:blank），
    /// 用 JS 显式打开更可靠；href 保留用于悬停预览与右键菜单。
    /// </summary>
    private async Task OpenAdminAsync()
    {
        if (string.IsNullOrWhiteSpace(_adminUrl))
            return;

        await JS.InvokeVoidAsync("open", _adminUrl, "_blank");
    }
}
