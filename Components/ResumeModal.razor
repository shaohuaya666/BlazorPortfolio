@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/80 backdrop-blur-md" @onclick="OnClose"></div>

        <div class="glass-card bg-[#0d1c2d] border border-slate-700 max-w-2xl w-full rounded-2xl shadow-2xl overflow-hidden relative z-10 max-h-[90vh] flex flex-col font-sans">
            <div class="flex items-center justify-between border-b border-slate-800 p-5 bg-[#051424]">
                <h3 class="font-mono text-sm font-bold text-white">PORTABLE_RESUME_SNAPSHOT.BIN</h3>
                <button class="text-slate-400 hover:text-white" @onclick="OnClose">
                    <span class="material-symbols-outlined text-sm">close</span>
                </button>
            </div>

            <div class="p-6 overflow-y-auto space-y-6 text-xs leading-normal">
                <div class="border-b border-slate-800 pb-4">
                    <h4 class="text-xl font-bold text-white">15年全栈开发专家 (Blazor Render Template)</h4>
                    <p class="text-[#4fdbc8] font-mono text-[10px]">C# &amp; .NET Core 8.0 Expert Team</p>
                </div>

                <div class="bg-[#051424] p-4 rounded border border-slate-800 font-mono">
                    <h5 class="text-white font-bold mb-2">主研技术特征 Mastery Profiles</h5>
                    <p class="text-slate-400">
                        .NET Core 8.0 SDK, C# 12, SqlSugar ORM, SignalR Real-Time Broadcaster, Microservices Cluster setup, RFID integration, RS232 COM port driver design.
                    </p>
                </div>
            </div>

            <div class="flex gap-2 border-t border-slate-800 p-4 bg-[#051424]">
                <button class="flex-grow bg-[#3b82f6] text-white py-2 rounded text-xs font-mono font-bold" @onclick="OnClose">
                    CLOSE BIN VIEW
                </button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// 是否显示模态框
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// 关闭模态框的回调
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }
}
